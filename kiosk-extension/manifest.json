{
  "manifest_version": 3,
  "name": "Naturgy Kiosk Iframe Enabler",
  "version": "1.0",
  "description": "Remove restrições de X-Frame-Options e CSP para o Totem Naturgy",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "strip_frame_headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
